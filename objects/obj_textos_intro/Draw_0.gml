scribble("[scale,1.4][delay,1000][delay]hardware[delay20].[delay20].[delay].[delay50]      [c_green]operational[/c]\nfirmware[delay20].[delay20].[delay].[delay20]         [c_green]ok[/c]\nRAM...[delay,100]              [c_green]ok[/c]\nROM...[delay,100]              [c_green]ok[/c]\nCPU...              [c_green]ok[/c]\nGPU[delay].[delay].[delay].[delay][delay]              [c_red]FAIL[/c][delay][c_gray]\n\nmoving rendering  to CPU[delay]...\n\n..[delay]..[delay]..[delay][c_green]SUCCESS[/c][delay]\n\ncontroller[delay].[delay].[delay].[delay][delay]         [c_red]FAIL[/c]\n\n[c_yellow][blink]please connect a controller").draw(60,60,typist);